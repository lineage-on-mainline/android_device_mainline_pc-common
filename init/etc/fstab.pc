#<src>                                                  <mnt_point>            <type>  <mnt_flags and options>                                                              <fs_mgr_flags>
/dev/block/by-name/boot                                 /boot                  emmc    defaults                                                                             defaults
/dev/block/by-name/recovery                             /recovery              emmc    defaults                                                                             defaults
/dev/block/by-name/misc                                 /misc                  emmc    defaults                                                                             defaults

odm                                                     /odm                   erofs   noatime,ro                                                                           wait,logical,first_stage_mount,readahead_size_kb=128
odm_dlkm                                                /odm_dlkm              erofs   noatime,ro                                                                           wait,logical,first_stage_mount,readahead_size_kb=128,avb_keys=no_such_key
system                                                  /system                ext4    noatime,ro                                                                           wait,logical,first_stage_mount,readahead_size_kb=128
system_dlkm                                             /system_dlkm           erofs   noatime,ro                                                                           wait,logical,first_stage_mount,readahead_size_kb=128,avb_keys=no_such_key
system_ext                                              /system_ext            ext4    noatime,ro                                                                           wait,logical,first_stage_mount,readahead_size_kb=128
product                                                 /product               ext4    noatime,ro                                                                           wait,logical,first_stage_mount,readahead_size_kb=128
vendor                                                  /vendor                erofs   noatime,ro                                                                           wait,logical,first_stage_mount,readahead_size_kb=128
vendor_dlkm                                             /vendor_dlkm           erofs   noatime,ro                                                                           wait,logical,first_stage_mount,readahead_size_kb=128,avb_keys=no_such_key

/dev/block/by-name/metadata                             /metadata              f2fs    noatime,nosuid,nodev,discard                                                         wait,check,formattable,first_stage_mount
/dev/block/by-name/cache                                /cache                 f2fs    noatime,nosuid,nodev,discard                                                         wait,check,formattable,readahead_size_kb=128
/dev/block/by-name/userdata                             /data                  f2fs    noatime,nosuid,nodev,discard,reserve_root=32768,resgid=1065,fsync_mode=nobarrier     wait,check,formattable,quota,reservedsize=128M,checkpoint=fs,readahead_size_kb=128

# ZRAM
/dev/block/zram0                                        none                   swap    defaults                                                                             zramsize=50%
